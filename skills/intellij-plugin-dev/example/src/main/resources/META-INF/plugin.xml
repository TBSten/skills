<idea-plugin>
    <id>com.example.plugin</id>
    <name>Example Plugin</name>
    <vendor>Example Vendor</vendor>
    <!-- CUSTOMIZE: describe the plugin. -->
    <description><![CDATA[
        A Jewel/Compose tool window backed by the Kotlin Analysis API.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The Analysis API. Can become optional (config-file) if only some features need it. -->
    <depends>org.jetbrains.kotlin</depends>

    <!-- v2 module dependencies, paired with bundledModule(...) in build.gradle.kts, so that Jewel and
         Compose are resolved from the IDE through the plugin classloader. -->
    <dependencies>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.libraries.compose.runtime.desktop"/>
        <module name="intellij.libraries.compose.foundation.desktop"/>
        <module name="intellij.libraries.skiko"/>
    </dependencies>

    <!-- Paired with the idea.kotlin.plugin.use.k2 system property of the test task. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The id is also the tool window's title. Keep it equal to ExampleToolWindowFactory.TOOL_WINDOW_ID. -->
        <toolWindow id="Example Tool Window" anchor="right" factoryClass="com.example.plugin.ExampleToolWindowFactory"/>
        <!-- TODO(CUSTOMIZE): register a gutter line marker once one is implemented, e.g.
        <codeInsight.lineMarkerProvider language="kotlin" implementationClass="com.example.plugin.ExampleLineMarkerProvider"/>
        -->
    </extensions>
</idea-plugin>
